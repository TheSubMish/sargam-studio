# Copy this file to .env and fill in real values. .env is git-ignored — never
# commit it. Only publishable/anon-style keys belong here; never a
# service_role key, a database password/connection string, or a Stripe
# *secret* key (see CLAUDE.md's Supabase section for the full reasoning).
# Stripe's secret key and webhook signing secret are Supabase Edge Function
# secrets instead (`supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=...`)
# — they never enter this repo or this desktop binary at all.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
