[Unit]
Description=Publish a Sargam Studio composition three times a day

[Timer]
# Local time. The random delay spreads releases so they don't land on the minute.
OnCalendar=*-*-* 07:00:00
OnCalendar=*-*-* 13:00:00
OnCalendar=*-*-* 19:00:00
RandomizedDelaySec=900
# If the machine was off at a scheduled time, run once when it comes back.
Persistent=true

[Install]
WantedBy=timers.target
